<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>uas</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <Version>0.0.0.0</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <!-- Set by the release workflow (framework-dependent / self-contained) so a published build
         knows which release asset to download when updating itself. Local builds carry no flavour,
         and that absence is what marks them as unpublished. -->
    <ItemGroup Condition="'$(BuildFlavor)' != ''">
        <AssemblyMetadata Include="BuildFlavor" Value="$(BuildFlavor)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
        <ProjectReference Include="..\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        <PackageReference Include="SkiaSharp" Version="2.88.9" />
        <PackageReference Include="Superpower" Version="3.2.1" />
        <PackageReference Include="System.CommandLine" Version="2.0.10" />
        <PackageReference Include="Svg.Skia" Version="3.2.1" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <Target Name="StampGitRevisions" BeforeTargets="GetAssemblyAttributes">
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..&quot; rev-parse --short HEAD"
              ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="UasGitSha" />
            <Output TaskParameter="ExitCode" PropertyName="UasGitExitCode" />
        </Exec>
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\CUE4Parse&quot; rev-parse --short HEAD"
              Condition="Exists('$(MSBuildProjectDirectory)\..\CUE4Parse\.git')"
              ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="Cue4ParseGitSha" />
            <Output TaskParameter="ExitCode" PropertyName="Cue4ParseGitExitCode" />
        </Exec>
        <PropertyGroup>
            <UasGitSha Condition="'$(UasGitExitCode)' != '0' or '$(UasGitSha)' == ''">unknown</UasGitSha>
            <Cue4ParseGitSha Condition="'$(Cue4ParseGitExitCode)' != '0' or '$(Cue4ParseGitSha)' == ''">unknown</Cue4ParseGitSha>
        </PropertyGroup>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>UasGitSha</_Parameter1>
                <_Parameter2>$(UasGitSha)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>Cue4ParseGitSha</_Parameter1>
                <_Parameter2>$(Cue4ParseGitSha)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

</Project>
